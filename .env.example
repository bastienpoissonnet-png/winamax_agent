# ==============================================================================
# Configuration de l'Agent d'Aide à la Décision Paris Sportifs (Winamax)
# ==============================================================================

# Clé API The Odds API (Gratuit : 500 requêtes/mois sur https://the-odds-api.com)
ODDS_API_KEY=votre_cle_the_odds_api_ici

# Clé API Football-Data.org (Gratuit : https://www.football-data.org/client/register)
FOOTBALL_DATA_API_KEY=votre_cle_football_data_ici

# Webhook Discord pour notifications mobiles (Optionnel - URL Webhook Discord du salon)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Bookmaker cible pour les cotes (winamax, ou fallback vers betclic, unibet_fr)
BOOKMAKER=winamax

# Compétitions suivies (séparées par une virgule)
# - Ligue des Nations : soccer_uefa_nations_league
# - Ligue 1 : soccer_france_ligue_one
# - Premier League : soccer_epl
# - La Liga : soccer_spain_la_liga
# - Serie A : soccer_italy_serie_a
# - Bundesliga : soccer_germany_bundesliga
# - Ligue des Champions : soccer_uefa_champs_league
# - Ligue Europa : soccer_uefa_europa_league
COMPETITIONS=soccer_uefa_nations_league,soccer_france_ligue_one,soccer_epl,soccer_spain_la_liga,soccer_italy_serie_a,soccer_germany_bundesliga,soccer_uefa_champs_league,soccer_uefa_europa_league

# Marchés ciblés (h2h = 1X2, totals = Plus/Moins de buts)
MARKETS=h2h,totals

# Paramètres de gestion de bankroll et staking (Paris simples)
TOTAL_BANKROLL=500.0
KELLY_FRACTION=0.50          # Demi-Kelly (50%)
MIN_STAKE=1.0                # Plancher de mise (1 €)
MAX_STAKE=20.0               # Plafond absolu strict (20 €)
MIN_EV_THRESHOLD=0.005       # +0.5% d'edge minimum
MIN_ODDS=1.50                # Sweet spot 1.50 - 3.00
MAX_ODDS=3.00
MIN_PROB_THRESHOLD=0.40
MIN_PROB_LOW_ODDS=0.60

# Générateur de combinés intelligents (2 à 3 sélections)
PARLAY_MIN_PROB=0.60
PARLAY_MIN_ODDS=1.80
PARLAY_MAX_ODDS=4.00
PARLAY_MAX_STAKE=15.0
PARLAY_KELLY_FRACTION=0.35

# Paramètres de la « Cote Osée » (Fun Bet cote >= 4.00, Micro-Kelly)
LONGSHOT_MIN_ODDS=4.00
LONGSHOT_MAX_ODDS=15.00
LONGSHOT_MAX_STAKE=5.0
LONGSHOT_MIN_STAKE=1.0
LONGSHOT_KELLY_FRACTION=0.15

# Paramètres du mode de secours (Fallback automatique si EV <= 0)
FALLBACK_STAKE=1.00           # Mise symbolique de secours (1.00 € max recommandé)

# Fréquence d'exécution planifiée (en heures)
SCHEDULE_INTERVAL_HOURS=6

# Mode simulation / données de démonstration (true si aucune clé API active)
SIMULATION_MODE=false

